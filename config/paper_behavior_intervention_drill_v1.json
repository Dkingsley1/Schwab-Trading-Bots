          "expected_action": "BUY",
          "expected_max_size_multiplier_norm": 0.25,
          "expected_trigger": "candidate_maturity_scaling"
        },
        {
          "case_id": "clean_mature_buy_preserved",
          "requested_action": "BUY",
          "feature_overrides": {},
