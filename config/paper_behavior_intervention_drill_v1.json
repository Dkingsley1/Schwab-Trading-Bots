          "diagnostic_round_trip_cost_bps": 6.0,
          "expected_action": "HOLD",
          "expected_trigger": "staged_recovery_reentry"
        }
      ]
    },
    {
      "scenario_id": "partial_fill_inventory_guard",
      "intervention_id": "partial_fill_inventory_guard",
      "cases": [
        {
          "case_id": "unresolved_partial_fill_above_hard_floor",
          "requested_action": "BUY",
          "feature_overrides": {"unresolved_partial_fill_inventory_norm": 0.82},
          "diagnostic_forward_return_bps": -28.0,
          "diagnostic_round_trip_cost_bps": 9.0,
          "expected_action": "HOLD",
          "expected_trigger": "partial_fill_inventory_guard"
        }
      ]
    },
    {
      "scenario_id": "winner_add_discipline",
      "intervention_id": "winner_add_discipline",
      "cases": [
        {
          "case_id": "runner_add_without_confirmation",
          "requested_action": "BUY",
