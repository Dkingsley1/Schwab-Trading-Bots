    },
    {
      "scenario_id": "regime_transition_hysteresis",
      "intervention_id": "regime_transition_hysteresis",
      "cases": [
        {
          "case_id": "transition_between_floors",
          "requested_action": "BUY",
          "feature_overrides": {"regime_transition_risk_norm": 0.72},
