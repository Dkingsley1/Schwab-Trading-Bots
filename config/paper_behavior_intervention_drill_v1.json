          "diagnostic_round_trip_cost_bps": 6.0,
          "expected_action": "HOLD",
          "expected_trigger": "horizon_conflict_abstention"
        }
      ]
    },
    {
      "scenario_id": "maturity_and_action_integrity",
      "intervention_id": "candidate_maturity_scaling",
      "cases": [
        {
          "case_id": "immature_candidate_deweighted",
          "requested_action": "BUY",
          "feature_overrides": {"candidate_bound_post_cost_samples": 5},
          "diagnostic_forward_return_bps": -12.0,
