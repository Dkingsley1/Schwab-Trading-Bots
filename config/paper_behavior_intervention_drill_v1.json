          "expected_trigger": "regime_transition_hysteresis"
        }
      ]
    },
    {
      "scenario_id": "unconfirmed_recovery_reentry",
      "intervention_id": "staged_recovery_reentry",
      "cases": [
        {
          "case_id": "recovery_without_confirmation",
          "requested_action": "BUY",
          "feature_overrides": {"recovery_reentry_confirmation_norm": 0.42},
