          "requested_action": "BUY",
          "feature_overrides": {"portfolio_drawdown_pressure_norm": 0.9},
          "diagnostic_forward_return_bps": -35.0,
          "diagnostic_round_trip_cost_bps": 7.0,
          "expected_action": "HOLD",
          "expected_trigger": "drawdown_loss_streak_throttle"
