{
  "schema_version": 2,
  "policy_id": "sleeve_ingestion_routing_v2",
  "operating_mode": "decision_aligned_observation_routing",
  "purpose": "Bind each bot and runtime sleeve to a bounded, decision-family-specific data route with explicit quality, lineage, freshness, failover, and degradation semantics.",
  "decision_alignment": {
    "decision_policy_path": "config/institutional_decision_flow_v1.json",
    "decision_stage": "02_data_qualification",
    "require_family_resolution": true,
    "require_profile_receipt": true,
    "paper_and_live_share_route_definition": true,
    "live_requires_independent_evidence": true
  },
  "lane_contracts": {
    "core": {
      "priority": 100,
      "latency_class": "decision_path",
      "storage_temperature": "hot",
      "backpressure_policy": "preserve_and_throttle_optional_context",
      "failure_policy": "serve_fresh_last_good_then_collect_only"
    },
    "deferred": {
      "priority": 60,
      "latency_class": "research_path",
      "storage_temperature": "warm",
      "backpressure_policy": "quota_limit_and_age_fairly",
      "failure_policy": "defer_without_blocking_healthy_paper_collection"
    },
    "cold": {
      "priority": 20,
      "latency_class": "archive_path",
      "storage_temperature": "cold",
      "backpressure_policy": "pause_before_hot_or_warm_work",
      "failure_policy": "retry_in_maintenance_window"
    }
  },
  "route_quality_contract": {
    "weights": {
      "source_authority": 0.2,
      "collector_quality": 0.2,
      "freshness_margin": 0.18,
      "capability_proof": 0.16,
      "source_coverage": 0.1,
      "error_budget_remaining": 0.1,
      "payload_integrity": 0.06
    },
    "source_authority_scores": {
      "official": 1.0,
      "broker_native": 0.98,
      "official_derived": 0.94,
      "official_public_mesh": 0.9,
      "internal_control": 0.88,
      "internal_derived": 0.84,
      "internal_replay": 0.8,
      "licensed": 0.8,
      "public_licensed_mesh": 0.76,
      "public_mesh": 0.7,
      "public": 0.62
    },
    "paper_route_score_floor": 0.7,
    "live_route_score_floor": 0.86,
    "required_capability_coverage_floor": 1.0,
    "minimum_independent_live_failovers": 1,
    "unknown_quality_fails_to_conservative_default": true,
    "selection_tie_breakers": [
      "route_score_desc",
      "source_authority_desc",
      "freshness_age_asc",
      "producer_id_asc"
    ]
  },
