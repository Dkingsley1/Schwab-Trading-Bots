  "minimum_reentry_discount_fraction": 0.015,
  "round_trip_cost_bps": 24.0,
  "unknown_tax_friction_bps": 300.0,
  "settlement_business_days": 1,
  "wash_sale_window_days": 30,
  "dividend_blackout_days_before_ex_date": 3,
  "dividend_blackout_days_after_ex_date": 1,
  "maximum_reentry_wait_days": 20,
