  "query_contract": {
    "contract_id": "point_in_time_research_query_v1",
    "required_fields": ["dataset_id", "consumer_id", "purpose", "as_of_utc", "valid_at_utc"],
    "maximum_dataset_count_per_query": 12,
    "require_catalog_receipt": true,
    "require_entitlement_check": true,
    "fail_on_future_knowledge": true,
    "return_query_receipt": true
  },
  "bitemporal_contract": {
    "effective_from_field": "effective_at_utc",
    "effective_to_field": "effective_until_utc",
    "known_at_field": "known_at_utc",
    "superseded_at_field": "superseded_at_utc",
    "revision_id_field": "revision_id",
    "never_overwrite_prior_revision": true,
    "latest_known_revision_per_natural_key": true
  },
  "alpha_lifecycle": {
    "states": ["raw_feature", "candidate_alpha", "validated_alpha", "sleeve_strategy", "portfolio_candidate", "parked", "retired"],
    "allowed_transitions": {
      "raw_feature": ["candidate_alpha", "parked", "retired"],
      "candidate_alpha": ["validated_alpha", "parked", "retired"],
      "validated_alpha": ["sleeve_strategy", "parked", "retired"],
      "sleeve_strategy": ["portfolio_candidate", "parked", "retired"],
      "portfolio_candidate": ["parked", "retired"],
      "parked": ["candidate_alpha", "retired"],
      "retired": []
    },
    "required_evidence_by_target_state": {
      "candidate_alpha": ["dataset_receipts", "hypothesis_id", "candidate_id"],
      "validated_alpha": ["holdout_receipt", "multiple_testing_receipt", "post_cost_evidence_receipt"],
      "sleeve_strategy": ["sleeve_id", "regime_contract_receipt", "risk_contract_receipt"],
      "portfolio_candidate": ["portfolio_advisory_receipt", "capacity_receipt", "correlation_receipt"],
      "parked": ["reason"],
      "retired": ["reason"]
    },
    "live_execution_authority": false
  },
  "source_value_policy": {
    "minimum_candidate_bound_samples": 30,
    "weights": {
      "quality": 0.2,
      "freshness": 0.15,
      "availability": 0.15,
      "incremental_information": 0.2,
      "net_post_cost_contribution": 0.2,
      "nonredundancy": 0.1
    },
    "source_count_is_value": false,
    "missing_outcome_metrics_status": "collecting",
    "automatic_source_purchase_authority": false,
    "automatic_source_retirement_authority": false
  },
  "portfolio_combination": {
    "delegate": "core.portfolio_advisory.build_multi_period_advisory",
    "minimum_qualified_sleeves": 4,
    "minimum_independent_fills": 30,
    "cash_floor": 0.1,
    "maximum_sleeve_weight": 0.25,
    "maximum_step_turnover": 0.2,
    "maximum_pairwise_correlation": 0.75,
    "advisory_only": true
  },
  "simulation_contract": {
    "contract_id": "unified_market_and_order_event_v1",
    "supported_modes": ["research", "backtest", "replay", "shadow", "paper", "live_shadow", "live"],
    "mode_invariant_fields": ["event_id", "trace_id", "candidate_id", "symbol", "event_time_utc", "known_at_utc", "event_type", "payload_sha256"],
    "mode_specific_fields": ["broker_order_id", "fill_price", "fill_quantity", "latency_ms", "fee_amount", "slippage_bps"],
    "live_mode_representation_does_not_grant_submission": true,
    "paper_live_equivalence_required_before_promotion": true
  },
  "feed_slo_contract": {
    "minimum_completeness_ratio": 0.98,
    "minimum_validity_ratio": 0.99,
    "minimum_availability_ratio": 0.99,
    "maximum_correction_ratio": 0.02,
    "missing_observation_status": "unknown",
    "degradation_actions": ["use_independent_failover", "quarantine_invalid_rows", "collect_only", "block_candidate_promotion"],
    "feed_failure_does_not_grant_fallback_order_authority": true
  },
  "reproducibility_contract": {
    "contract_id": "research_reproducibility_receipt_v1",
    "required_materials": ["candidate_id", "code_revision", "dataset_receipts", "parameter_receipt", "label_contract_receipt", "cost_model_receipt", "result_receipt"],
    "canonical_json_required": true,
    "local_receipt_is_not_external_attestation": true,
    "historical_results_may_not_be_rewritten": true
  },
  "public_influences": [
    {
      "id": "trexquant_research_platform",
      "organization": "Trexquant Investment LP",
      "official_url": "https://trexquant.com/",
      "supplementary_urls": [
        "https://trexquant.com/careers/13A32AB65C",
        "https://trexquant.com/careers/6D8F95262F"
      ],
      "principles": ["data-to-alpha-to-strategy separation", "proprietary simulation workflow", "data quality and lineage", "event-based orchestration", "market-neutral portfolio construction"],
      "influence_only": true
    }
  ],
  "soak_contract": {
    "classification": "additive_observability_and_research_governance",
    "preserve_cumulative_history": true,
    "reset_main_soak_clock": false,
    "changes_signal_or_order_semantics": false,
    "new_control_evidence_accrues_forward": true
  }
}
