{
  "schema_version": 1,
  "policy_id": "research_data_platform_v1",
  "purpose": "Provide one local-first contract for data discovery, permitted use, point-in-time research access, alpha lifecycle evidence, feed reliability, simulation parity, and reproducible research without granting trading authority.",
  "authority": {
    "metadata_and_research_control_only": true,
    "can_change_signal": false,
    "can_change_action": false,
    "can_change_quantity": false,
    "can_allocate_capital": false,
    "can_promote_live": false,
    "can_submit_order": false,
    "can_purchase_data": false
  },
  "required_capability_ids": [
    "canonical_data_catalog",
    "license_entitlement_registry",
    "point_in_time_research_api",
    "bitemporal_revision_history",
    "alpha_lifecycle_governance",
    "source_value_accounting",
    "portfolio_alpha_combination",
    "unified_simulation_semantics",
    "feed_service_levels",
    "research_reproducibility"
  ],
  "capabilities": {
    "canonical_data_catalog": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Give every research dataset a stable identity, schema, temporal contract, owner, source lineage, consumers, storage class, and lifecycle."
    },
    "license_entitlement_registry": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Fail closed on undeclared uses and keep credentials, redistribution rights, derived-data rights, and subscription evidence separate."
    },
    "point_in_time_research_api": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Build deterministic, receipt-bound query plans and return only rows knowable at the requested decision time."
    },
    "bitemporal_revision_history": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Preserve effective time and knowledge time so revised macro and reference values cannot leak backward into research."
    },
    "alpha_lifecycle_governance": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Enforce evidence-bearing transitions from raw feature through candidate, validated sleeve strategy, and portfolio candidate states."
    },
    "source_value_accounting": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Measure incremental candidate-bound value, reliability, redundancy, latency, and cost without treating source count as alpha."
    },
    "portfolio_alpha_combination": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Delegate to the existing constrained portfolio advisory and preserve correlation, turnover, capacity, cost, and cash constraints."
    },
    "unified_simulation_semantics": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Normalize research, replay, paper, shadow, and live-shadow events into one non-submitting contract with explicit mode differences."
    },
    "feed_service_levels": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Evaluate freshness, completeness, validity, correction, and availability targets per data product with bounded degradation actions."
    },
    "research_reproducibility": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Hash candidate identity, code, datasets, parameters, labels, costs, and results into a local reproducibility receipt."
    }
  },
  "decision_family_contract": {
    "required_family_ids": [
      "balanced_directional",
      "commodity_inflation",
      "digital_asset_basis",
      "event_driven",
      "infrastructure_control",
      "intraday_momentum",
      "liquidity_microstructure",
      "long_horizon_income",
      "macro_rates_fx",
      "relative_value",
      "research_models",
      "structured_credit",
      "swing_directional",
      "tail_hedge",
      "volatility_derivatives"
    ],
    "minimum_products_per_family": 2,
    "every_family_must_have_point_in_time_product": true,
    "every_family_must_have_outcome_evidence_product": true
  },
  "license_profiles": {
    "official_public_internal": {
      "allowed_uses": ["research", "paper_decision_context", "internal_derived_feature", "simulation", "audit"],
      "prohibited_uses": ["credential_storage", "unapproved_redistribution", "automatic_live_authority"],
      "derived_data_allowed": true,
      "redistribution_allowed": false,
      "external_terms_review_required": false
    },
    "public_terms_review": {
      "allowed_uses": ["research", "paper_decision_context", "internal_derived_feature", "simulation", "audit"],
      "prohibited_uses": ["credential_storage", "unapproved_redistribution", "automatic_live_authority"],
      "derived_data_allowed": true,
      "redistribution_allowed": false,
      "external_terms_review_required": true
    },
    "broker_account_restricted": {
      "allowed_uses": ["research", "paper_decision_context", "internal_derived_feature", "simulation", "audit"],
      "prohibited_uses": ["credential_storage", "redistribution", "cross_account_disclosure", "automatic_live_authority"],
      "derived_data_allowed": true,
      "redistribution_allowed": false,
      "external_terms_review_required": true
    },
    "internal_derived": {
      "allowed_uses": ["research", "paper_decision_context", "internal_derived_feature", "simulation", "audit"],
      "prohibited_uses": ["source_lineage_removal", "historical_relabeling", "automatic_live_authority"],
      "derived_data_allowed": true,
      "redistribution_allowed": false,
      "external_terms_review_required": false
    }
  },
