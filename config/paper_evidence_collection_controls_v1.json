{
  "schema_version": 1,
  "policy_id": "paper_evidence_collection_controls_v1",
  "enabled": true,
  "paper_only": true,
  "live_execution_allowed": false,
  "purpose": "Allow bounded paper-only sampling for current-candidate evidence collection when sleeves have enough point-in-time context to make a trade reasonable, while preserving all profitability, promotion, and live-money gates.",
  "non_relaxed_controls": [
    "market_data_only_lock",
    "live_execution_lock",
    "staged_promotion_cohort_hard_blocks",
    "contract_valuation_guard",
    "weak_profile_new_entry_quarantine",
    "losing_strategy_pair_quarantine",
    "stale_quote_or_extended_session_blocks",
    "hard_liquidity_tradeability_spread_conflict_floors",
    "same_order_reversal_block",
    "paper_risk_guard",
    "profitability_claim_firewall"
  ],
  "forbidden_shortcuts": [
    "force_trades_to_create_samples",
    "martingale_or_averaging_down_for_recovery",
    "loss_based_size_increase",
    "direct_threshold_loosen_without_positive_counterfactual_post_cost_evidence",
    "live_execution_before_operator_release",
    "rewriting_or_offsetting_historical_paper_losses"
  ],
  "defaults": {
    "enabled": true,
    "mode": "paper_evidence_collection",
    "allowed_guard_reasons": [
      "paper_profitability_entry_policy_block",
      "paper_profitability_clean_profile_evidence_block"
    ],
    "allowed_entry_policy_blockers": [
      "predicted_edge_lower_bound_unknown",
      "liquidity_unknown",
      "session_quality_unknown"
    ],
    "allowed_clean_gate_failures": [
      "event_catalyst_confirmation_unknown",
      "portfolio_conflict_clearance_unknown",
      "session_quality_unknown",
      "independent_evidence_channel_floor_not_met"
    ],
    "minimum_model_score_edge_over_threshold": 0.02,
    "minimum_known_core_channels": 4,
    "hard_min_tradeability_norm": 0.5,
    "hard_min_execution_fitness_norm": 0.5,
