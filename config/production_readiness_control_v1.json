{
  "schema_version": 1,
  "control_policy": "production_grade_controls_before_live_feature_enablement",
  "default_dependency_activation_batch": "production_core_safe",
  "live_execution_risk_firewall": {
    "market_data_only_default": true,
    "allow_order_execution_env": "ALLOW_ORDER_EXECUTION",
    "market_data_only_env": "MARKET_DATA_ONLY",
    "max_single_order_notional": 100.0,
    "max_daily_loss": 2.0,
    "max_cumulative_loss": 10.0,
    "max_order_quantity": 1,
    "max_quote_age_seconds": 15.0,
    "max_account_snapshot_age_seconds": 30.0,
    "max_spread_bps": 75.0,
    "max_future_clock_skew_seconds": 2.0,
    "live_execution_envelope_ttl_seconds": 15.0,
    "require_sealed_live_execution_envelope": true,
    "require_affirmative_risk_decision": true,
    "require_quote_provenance": true,
    "allowed_quote_providers": [
      "schwab"
    ],
    "allowed_order_types": [
      "LIMIT"
    ],
    "allowed_sessions": [
      "NORMAL"
    ],
    "allowed_durations": [
      "DAY"
    ],
    "require_whole_share_quantity": true,
    "equity_tick_size": 0.01,
    "cancel_unfilled_after_seconds": 60,
    "require_primary_equity_session_open": true,
    "primary_equity_calendar_id": "XNYS",
    "equity_auction_buffer_minutes": 5.0,
    "mutating_broker_retries_after_dispatch_allowed": false,
    "allow_live_order_replace": false,
    "allowed_asset_types": ["EQUITY"],
    "allowed_instructions": ["BUY", "SELL"],
    "allow_new_short_positions": false,
    "permit_verified_emergency_risk_reduction": true,
    "canary_allowlist_path": "governance/runtime/live_canary_allowlist.json",
    "canary_plan_path": "config/live_canary_micro_policy_v1.json",
    "production_candidate_state_path": "governance/runtime/production_candidate_state.json",
    "symbol_lifecycle_path": "config/symbol_lifecycle_v1.json",
    "require_candidate_bound_canary_allowlist": true,
    "account_reference_env": "SCHWAB_ACCOUNT_HASH",
    "account_auto_discover_env": "SCHWAB_ACCOUNT_HASH_AUTO_DISCOVER",
    "require_pinned_account_reference": true,
    "require_hash_account_reference": true,
    "require_live_canary_preflight": true,
    "account_policy_registry_path": "config/account_policy_registry.json",
    "account_position_study_path": "governance/health/account_position_study_latest.json",
    "max_account_preflight_age_seconds": 120.0,
    "live_canary_operator_attestation_path": "governance/runtime/live_canary_operator_attestation.json",
    "risk_service_boundary_path": "governance/risk/risk_service_boundary_latest.json",
    "max_risk_boundary_age_seconds": 900.0,
    "live_order_ledger_control_path": "governance/health/live_order_ledger_control_latest.json",
    "max_live_order_ledger_age_seconds": 120.0,
    "release_freeze_guard_path": "governance/health/release_freeze_guard_latest.json",
    "max_release_guard_age_seconds": 900.0,
    "trading_tax_ledger_path": "governance/tax/trading_tax_ledger_{year}_latest.json",
    "max_tax_ledger_age_seconds": 86400.0,
    "regime_control_plane_path": "governance/health/regime_control_plane_latest.json",
    "max_regime_evidence_age_seconds": 900.0,
    "wash_sale_review_lookback_days": 31,
    "require_schwab_boundary_clear": true,
    "schwab_boundary_quarantine_artifact": "governance/health/SCHWAB_BROKER_BOUNDARY_QUARANTINE.json",
    "production_excellence_artifact": "governance/health/production_excellence_control_latest.json",
    "require_production_excellence_for_live_submit": true,
    "live_transition_integrity_artifact": "governance/health/live_transition_integrity_control_latest.json",
    "require_live_transition_integrity_for_live_submit": true,
    "system_role_contract_path": "config/system_role_contracts_v1.json",
    "live_execution_component_id": "live_execution_gateway",
    "require_system_role_contract_for_live_submit": true,
    "required_safety_flags": [
      "governance/health/PAPER_TRADE_LOCK.flag"
    ],
    "halt_flags": [
      "governance/health/OPERATOR_STOP.flag",
      "governance/health/GLOBAL_TRADING_HALT.flag"
    ],
    "order_intent_path": "governance/health/live_order_intents_latest.json",
    "policy": "reject_by_default_unless live execution is explicitly armed and the candidate, account, settled-cash attestation, quote, risk, order-state, release, tax, and production-excellence evidence all pass"
  },
  "deterministic_replay": {
    "required_artifacts": [
      "governance/health/golden_replay_regression_latest.json",
      "governance/health/shadow_replay_diff_latest.json",
      "governance/health/replay_hash_registry_guard_latest.json"
    ],
    "fingerprint_paths": [
      "config/requirements.lock.txt",
      "config/library_candidate_routes_v1.json",
      "config/library_activation_profiles_v1.json",
      "config/production_readiness_control_v1.json"
    ],
    "baseline_path": "governance/health/production_readiness_replay_baseline.json",
    "policy": "same_inputs_same_replay_hashes_before_promotion"
  },
  "observability_redaction": {
    "enabled_by_default": false,
    "allowed_export_modes": ["disabled", "local_only", "otlp_local"],
    "redaction_patterns": [
      "(?i)bearer\\s+[a-z0-9._-]+",
      "(?i)(access[_-]?token|refresh[_-]?token|api[_-]?key|secret)\\s*[:=]\\s*['\\\"]?[^,\\s'\\\"]+",
      "(?i)(account|acct|account_id)\\s*[:=]\\s*['\\\"]?[a-z0-9-]{6,}",
      "(?i)(order[_-]?id)\\s*[:=]\\s*['\\\"]?[a-z0-9-]{6,}"
    ],
    "redaction_samples": [
      {
        "name": "bearer_token",
        "input": "Authorization: Bearer abc123.private-token",
        "must_not_contain": ["abc123.private-token"]
      },
      {
        "name": "account_id",
        "input": "account_id=123456789 strategy=intraday",
        "must_not_contain": ["123456789"]
      },
      {
        "name": "order_id",
        "input": "order_id=ORD-123456789 symbol=SPY",
        "must_not_contain": ["ORD-123456789"]
      }
    ],
    "policy": "telemetry_may_not_export_account_tokens_order_ids_or_high_cardinality_labels"
  },
  "release_gates": {
    "required_scripts": [
      "scripts/ops/dependency_activation_smoke.py",
      "scripts/ops/library_utilization_router.py",
      "scripts/ops/mlx_intelligence_router.py",
      "scripts/ops/promotion_pipeline.py",
      "scripts/ops/system_role_contract_control.py",
      "scripts/secret_scan.py"
    ],
    "required_artifacts": [
      "governance/health/library_utilization_router_latest.json",
      "governance/health/mlx_intelligence_router_latest.json",
      "governance/health/live_readiness_smoke_latest.json",
      "governance/health/promotion_quality_gate_latest.json",
      "governance/health/system_role_contract_latest.json"
    ],
    "policy": "release_requires_static_security_dependency_router_and_smoke_artifacts"
  },
  "data_integrity_gates": {
    "required_artifacts": [
      "governance/health/point_in_time_event_store_latest.json",
      "governance/health/retrain_schema_compatibility_latest.json",
      "governance/health/jsonl_sql_ingestion_health_schema_violations_latest.json",
      "governance/health/provider_mesh_latest.json",
      "governance/health/artifact_freshness_slo_latest.json"
    ],
    "policy": "point_in_time_schema_provider_freshness_and_no_lookahead_checks_before_signal_promotion"
  },
  "incident_rollback": {
    "snapshot_paths": [
      "config/requirements.lock.txt",
      "config/library_candidate_routes_v1.json",
      "config/library_activation_profiles_v1.json",
      "config/production_readiness_control_v1.json",
      "config/system_role_contracts_v1.json",
      "config/.env.library_utilization_router_override",
      "config/runtime_profiles/live.lock.txt",
      "config/runtime_profiles/ops.lock.txt",
      "config/runtime_profiles/research.lock.txt"
    ],
    "promotion_packet_paths": [
      "governance/champion_challenger/promotion_packet_latest.json",
      "governance/health/promotion_quality_gate_latest.json",
      "governance/health/incident_review_packet_latest.json"
    ],
    "rollback_manifest_path": "governance/rollback/production_rollback_manifest_latest.json",
    "rollback_commands": [
      "./scripts/ops/opsctl.sh global-halt-status --json",
      "./scripts/ops/opsctl.sh library-utilization-router --apply --json",
      "./scripts/ops/opsctl.sh live-readiness-smoke --json"
    ],
    "policy": "every_promotion_needs_hashable_inputs_artifacts_and_operator_rollback_steps"
  },
  "slo_error_budget": {
    "target_success_ratio": 0.999,
    "max_single_incident_budget_burn": 0.2,
    "required_artifacts": [
      "governance/health/production_quality_slo_guard_latest.json",
      "governance/health/live_reconciliation_slo_latest.json",
      "governance/health/paper_reconciliation_slo_latest.json",
      "governance/health/backpressure_slo_bot_latest.json",
      "governance/health/artifact_freshness_slo_latest.json"
    ],
    "policy": "freeze_feature_promotion_when_reliability_budget_is_burned_or_reconciliation_is_blocked"
  },
  "live_money_production_bar": {
    "enabled": true,
    "require_for_live_canary": true,
    "require_read_only_pre_canary": true,
    "required_domain_statuses": {
      "dependency_activation_smoke_runner": ["ready"],
      "live_execution_risk_firewall": ["ready_guarded"],
      "deterministic_replay_harness": ["ready"],
      "observability_redaction": ["ready"],
      "release_gates": ["ready"],
      "data_integrity_gates": ["ready"],
      "incident_and_rollback_system": ["ready"],
      "slo_error_budget_policy": ["ready"]
    },
    "required_capabilities": [
      {
        "capability_id": "system_role_contract",
        "title": "System Responsibility And Runtime Authority",
        "artifact": "governance/health/system_role_contract_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 0.5,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "external_alert_supervision",
        "title": "External Alert Supervision",
        "artifact": "governance/health/remote_alert_control_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 12,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "immutable_evidence_store",
        "title": "Immutable Evidence Store",
        "artifact": "governance/content_store/latest.json",
        "ready_statuses": ["ready", "ok"],
        "max_age_hours": 24,
        "truthy_keys": ["ok"],
        "max_count_by_key": {
          "unsafe_skipped_blob_count": 0
        },
        "required": true
      },
      {
        "capability_id": "source_verification",
        "title": "Source Verification",
        "artifact": "governance/health/source_verification_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 24,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "security_hardening_audit",
        "title": "Security Hardening Audit",
        "artifact": "governance/health/security_audit_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 36,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "secret_scan_zero_findings",
        "title": "Secret Scan Zero Findings",
        "artifact": "governance/health/secret_scan_latest.json",
