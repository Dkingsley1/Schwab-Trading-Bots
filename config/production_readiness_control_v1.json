        "max_age_hours": 36,
        "zero_count_keys": ["findings_count"],
        "required": true
      },
      {
        "capability_id": "auth_lease_continuity",
        "title": "Auth Lease Continuity",
        "artifact": "governance/health/auth_lease_manager_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 6,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "storage_disaster_recovery",
        "title": "Storage Disaster Recovery",
        "artifact": "governance/health/storage_disaster_recovery_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 24,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "blackstart_recovery",
        "title": "Blackstart Recovery",
        "artifact": "governance/health/blackstart_recovery_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 36,
        "truthy_keys": ["ok", "production_grade_ready"],
        "zero_count_keys": ["blocked_stage_count"],
        "required": true
      },
      {
        "capability_id": "paper_execution_truth_a_plus",
        "title": "Paper Execution Truth A+",
        "artifact": "governance/health/paper_execution_truth_layer_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 12,
        "truthy_keys": ["ok", "a_plus_ready"],
        "zero_count_keys": ["blocked_gates"],
        "required": true
      },
      {
        "capability_id": "production_slo_guard",
        "title": "Production SLO Guard",
        "artifact": "governance/health/production_quality_slo_guard_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 12,
        "truthy_keys": ["ok"],
        "zero_count_keys": ["breach_count", "critical_active_lane_count"],
        "required": true
      },
      {
        "capability_id": "live_reconciliation_slo",
        "title": "Live Reconciliation SLO",
        "artifact": "governance/health/live_reconciliation_slo_latest.json",
        "ready_statuses": ["ready", "ok"],
        "max_age_hours": 24,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "paper_reconciliation_slo",
        "title": "Paper Reconciliation SLO",
        "artifact": "governance/health/paper_reconciliation_slo_latest.json",
        "ready_statuses": ["ready", "ok"],
        "max_age_hours": 24,
        "truthy_keys": ["ok"],
        "required": true
      },
      {
        "capability_id": "telemetry_redaction_canary",
        "title": "Telemetry Redaction Canary",
        "artifact": "governance/health/telemetry_redaction_canary_latest.json",
        "ready_statuses": ["ready"],
        "max_age_hours": 36,
        "required": true
      },
      {
        "capability_id": "live_canary_governor_read_only_cap",
        "title": "Live Canary Governor Read-Only Cap",
        "artifact": "governance/health/live_canary_control_latest.json",
        "ready_statuses": ["blocked", "ready", "guarded"],
        "max_age_hours": 12,
        "truthy_keys": ["canary_weight_ok", "live_money_contract_enforced", "live_money_contract_hard_block"],
        "required": true
      },
      {
        "capability_id": "uniform_hardening_contract",
        "title": "Uniform Whole-System Hardening Contract",
        "artifact": "governance/health/uniform_hardening_contract_latest.json",
        "ready_statuses": ["ready", "ready_with_evidence_debt"],
        "max_age_hours": 1,
        "truthy_keys": ["ok", "uniform_floor_ready", "critical_runtime_ready"],
