{
  "schema_version": 1,
  "policy_id": "sleeve_strategy_specialization_v1",
  "purpose": "Materialize complete, objective-aware, candidate-bound contracts for every runtime sleeve strategy without granting decision, sizing, promotion, or live-order authority.",
  "source_manifest": "config/sleeve_strategy_expansion.json",
  "included_runtime_states": [
    "active_runtime",
    "active_data_collection"
  ],
  "included_sleeves": [
    "options_on_futures_aggressive"
  ],
  "identity": {
    "namespace": "sleeve",
    "version": "v1",
    "format": "sleeve::{sleeve_id}::{strategy_name}::v1",
    "receipt_algorithm": "sha256_canonical_json"
  },
  "authority": {
    "can_create_intent": false,
    "can_reverse_intent": false,
    "can_increase_quantity": false,
    "can_allocate_capital": false,
    "can_change_labels": false,
    "can_grant_promotion": false,
    "can_submit_live_order": false
  },
  "candidate_binding": {
    "required": true,
    "allow_historical_fallback": false,
    "allow_cross_candidate_pooling": false,
    "minimum_probation_samples": 30,
    "minimum_validation_samples": 100,
    "minimum_independent_days": 7,
    "minimum_independent_symbols": 3
  },
  "strategy_library": {
    "enabled": true,
    "target_total_strategies": 12000,
    "minimum_strategies_per_sleeve": 100,
    "allocation_policy": "balanced_floor_then_deterministic_lexicographic_remainder",
    "runtime_materialization": "hot_catalog_only",
    "cold_library_materialization": "report_and_research_on_demand",
    "max_generated_hot_slots_per_sleeve": 12,
    "max_concurrent_generated_experiments_per_sleeve": 3,
    "activation_policy": "cold_hypothesis_requires_explicit_candidate_bound_admission_before_counterfactual_ranking_training_or_paper_execution",
    "retirement_policy": "retired_or_duplicate_hypotheses_release_a_hot_slot_but_remain_in_the_audit_ledger",
    "conditioning_overlays": {
      "baseline_confirmation": {
        "confirmation": "primary_signal_and_sleeve_risk_qualification",
        "failure_mode": "single_signal_false_positive"
      },
      "regime_conditioned": {
        "confirmation": "primary_signal_plus_supported_market_regime",
        "failure_mode": "regime_misclassification_or_transition_lag"
      },
      "cross_source_confirmed": {
        "confirmation": "independent_point_in_time_sources_agree",
        "failure_mode": "correlated_or_stale_source_confirmation"
      },
      "cost_adjusted": {
        "confirmation": "expected_edge_exceeds_full_cost_and_uncertainty_hurdle",
        "failure_mode": "cost_underestimation_or_edge_decay"
      },
      "liquidity_qualified": {
        "confirmation": "spread_depth_volume_and_market_impact_are_qualified",
        "failure_mode": "liquidity_evaporation_or_adverse_selection"
      },
      "volatility_targeted": {
        "confirmation": "signal_survives_volatility_normalization_and_risk_budgeting",
        "failure_mode": "volatility_jump_or_targeting_lag"
      },
      "capacity_aware": {
        "confirmation": "participation_concentration_and_impact_capacity_remain_available",
        "failure_mode": "crowding_or_capacity_exhaustion"
      },
      "decay_aware": {
        "confirmation": "recent_candidate_forward_evidence_has_not_decayed",
        "failure_mode": "structural_break_or_signal_half_life_collapse"
      },
      "stress_tested": {
        "confirmation": "signal_survives_relevant_historical_and_synthetic_stress_scenarios",
        "failure_mode": "unmodeled_tail_or_cross_asset_contagion"
      },
      "ensemble_disagreement_gated": {
        "confirmation": "strategy_edge_survives_ensemble_disagreement_and_conflict_checks",
        "failure_mode": "hidden_factor_overlap_or_consensus_instability"
      },
      "benchmark_relative": {
        "confirmation": "signal_improves_on_the_objective_specific_benchmark_after_costs",
        "failure_mode": "beta_or_benchmark_misattribution"
      },
      "tail_risk_aware": {
        "confirmation": "signal_retains_utility_after_tail_loss_and_gap_risk_penalties",
        "failure_mode": "hidden_convexity_or_tail_dependence"
      }
    },
    "objective_archetypes": {
      "directional_alpha": [
        "time_series_momentum", "cross_sectional_momentum", "quality_value_composite", "earnings_revision_drift", "breadth_regime_rotation", "volatility_adjusted_breakout", "residual_mean_reversion", "defensive_trend_to_cash", "sector_relative_strength", "multi_horizon_signal_blend"
      ],
      "income_total_return": [
        "distribution_safety", "dividend_growth_acceleration", "total_yield_value", "payout_recovery", "tax_adjusted_income", "free_cash_flow_income", "rate_sensitivity_rotation", "income_volatility_control", "buyback_dividend_blend", "quality_income_reinvestment"
      ],
      "event_alpha": [
        "standardized_surprise", "implied_move_mispricing", "first_reaction_followthrough", "second_reaction_reversal", "pre_event_positioning", "post_event_drift", "source_ranked_catalyst", "gap_recovery", "event_volatility_reset", "cross_asset_event_spillover"
      ],
      "macro_carry_relative_value": [
        "carry_roll_down", "time_series_momentum", "valuation_reversion", "curve_relative_value", "policy_surprise", "inflation_growth_regime", "cross_asset_macro_rotation", "liquidity_stress", "seasonal_inventory", "hedge_adjusted_macro_blend"
      ],
      "digital_asset_alpha": [
        "digital_asset_momentum", "cross_sectional_token_rotation", "funding_carry", "spot_derivative_basis", "onchain_liquidity", "liquidation_reversal", "stablecoin_impulse", "venue_dispersion", "weekend_regime", "dominance_rotation"
      ],
      "basis_relative_value": [
        "spot_future_convergence", "calendar_basis", "cross_venue_basis", "funding_dispersion", "cash_and_carry", "reverse_cash_and_carry", "curve_kink", "collateral_adjusted_basis", "latency_resilient_basis", "basis_stress_exit"
      ],
      "volatility_relative_value": [
        "variance_risk_premium", "skew_relative_value", "term_structure_carry", "correlation_dispersion", "gamma_scalping", "vol_of_vol", "event_volatility_reset", "corridor_variance", "tail_convexity", "surface_relative_value"
      ],
      "market_neutral_relative_value": [
        "cointegration_spread", "residual_reversal", "factor_neutral_momentum", "sector_pairs", "kalman_dynamic_hedge", "statistical_arbitrage_blend", "lead_lag_convergence", "cross_asset_convergence", "crowding_unwind", "relationship_break_defense"
      ],
      "execution_alpha": [
        "opening_auction", "vwap_reversion", "liquidity_imbalance", "microprice_reversion", "toxicity_adjusted_spread_capture", "inventory_skew", "implementation_shortfall", "session_aware_execution", "queue_position", "impact_aware_scheduling"
      ],
      "hedge_utility": [
        "beta_hedge", "tail_hedge", "volatility_spike_hedge", "credit_stress_hedge", "crowding_unwind_hedge", "correlation_break_hedge", "duration_hedge", "liquidity_hedge", "convexity_budget", "dynamic_hedge_carry"
      ],
      "capital_preservation": [
        "trend_to_cash", "drawdown_throttle", "quality_minimum_variance", "t_bill_rotation", "defensive_sector_rotation", "volatility_reentry", "liquidity_preservation", "credit_stress_derisk", "opportunity_cost_optimized_cash", "slow_confirmation_reentry"
      ],
      "control_only": [
        "freshness_guard", "source_divergence_guard", "backlog_pressure_guard", "restart_storm_guard", "storage_capacity_guard", "memory_pressure_guard", "model_drift_guard", "authorization_lease_guard", "reconciliation_integrity_guard", "recovery_effectiveness_guard"
      ]
    }
  },
  "quality_assessment": {
    "verdicts": [
      "validated_good", "promising_unconfirmed", "mixed_watch", "weak", "retirement_candidate", "insufficient_evidence", "cold_untested", "objective_evidence_pending", "control_only"
    ],
    "good_requires": "candidate_bound_positive_clustered_lower_confidence_bound_after_costs_and_objective_specific_risk_checks",
    "bad_requires": "mature_candidate_bound_negative_post_cost_expectancy_with_negative_lower_confidence_bound_or_objective_specific_harm",
    "unknown_is_not_bad": true,
    "standalone_profit_forbidden_for": ["hedge_utility", "capital_preservation", "control_only"]
  },
  "regime_adaptation": {
    "enabled": true,
    "source_path": "governance/health/regime_control_plane_latest.json",
    "maximum_source_age_seconds": 3600,
    "fresh_source_required_for_cold_activation": true,
    "low_confidence_behavior": "retain_hot_runtime_contracts_and_block_cold_activation",
    "adaptation_scope": "ranking_research_admission_and_evidence_segmentation_only",
    "may_mutate_action_quantity_risk_limits_or_live_authority": false,
    "regime_affinity": {
      "risk_on_trend": {
        "favored_taxonomy": ["trend", "carry_value", "liquidity_execution"],
        "guarded_taxonomy": ["mean_reversion", "risk_control"]
      },
      "risk_off_shock": {
        "favored_taxonomy": ["risk_control", "volatility", "mean_reversion"],
        "guarded_taxonomy": ["trend", "carry_value", "liquidity_execution"]
      },
      "mixed_transition": {
        "favored_taxonomy": ["risk_control", "mean_reversion", "event", "volatility"],
        "guarded_taxonomy": ["trend", "carry_value"]
      },
      "range_bound": {
        "favored_taxonomy": ["mean_reversion", "carry_value", "liquidity_execution"],
        "guarded_taxonomy": ["trend"]
      },
      "high_volatility": {
        "favored_taxonomy": ["volatility", "risk_control", "event"],
        "guarded_taxonomy": ["carry_value", "liquidity_execution"]
      },
      "low_volatility": {
        "favored_taxonomy": ["carry_value", "liquidity_execution", "mean_reversion"],
        "guarded_taxonomy": ["volatility", "event"]
      },
      "liquidity_stress": {
        "favored_taxonomy": ["risk_control", "volatility"],
        "guarded_taxonomy": ["liquidity_execution", "carry_value", "trend"]
      }
    }
  },
  "profile_aliases": {
    "default": "equity_core",
    "aggressive": "equity_core",
    "dividend": "dividend_income",
    "dividend_compound": "dividend_income",
    "bond": "bond_rates",
    "fx": "fx_macro"
  },
  "objective_classes": {
    "directional_alpha": {
      "scorecard": "positive_candidate_forward_post_cost_expectancy_with_drawdown_and_turnover_limits",
      "primary_metric": "post_cost_return_bps",
      "benchmark_rule": "outperform_sleeve_benchmark_after_costs"
    },
    "income_total_return": {
      "scorecard": "tax_aware_income_plus_price_return_after_costs_and_drawdown",
      "primary_metric": "post_cost_total_return_bps",
      "benchmark_rule": "outperform_income_benchmark_on_total_return_and_distribution_safety"
    },
    "event_alpha": {
      "scorecard": "event_window_abnormal_return_after_spread_slippage_and_gap_risk",
      "primary_metric": "post_cost_event_abnormal_return_bps",
      "benchmark_rule": "outperform_matched_event_cohort"
    },
    "macro_carry_relative_value": {
      "scorecard": "carry_plus_roll_plus_price_return_after_funding_and_hedging_costs",
      "primary_metric": "post_cost_carry_adjusted_return_bps",
      "benchmark_rule": "outperform_asset_class_or_curve_benchmark"
    },
    "digital_asset_alpha": {
      "scorecard": "venue_aware_post_cost_return_with_funding_basis_and_weekend_risk",
      "primary_metric": "post_cost_return_bps",
      "benchmark_rule": "outperform_spot_or_futures_beta_benchmark"
    },
    "basis_relative_value": {
      "scorecard": "realized_basis_convergence_after_funding_fees_borrow_and_venue_risk",
      "primary_metric": "post_cost_basis_capture_bps",
      "benchmark_rule": "positive_market_neutral_basis_capture"
    },
    "volatility_relative_value": {
      "scorecard": "realized_option_payoff_after_premium_greeks_slippage_and_tail_loss",
      "primary_metric": "post_cost_volatility_risk_premium_bps",
      "benchmark_rule": "outperform_delta_hedged_volatility_benchmark"
    },
    "market_neutral_relative_value": {
      "scorecard": "factor_neutral_spread_convergence_after_borrow_turnover_and_impact",
      "primary_metric": "post_cost_residual_return_bps",
      "benchmark_rule": "positive_residual_return_with_bounded_beta"
    },
    "execution_alpha": {
      "scorecard": "implementation_shortfall_spread_capture_adverse_selection_and_inventory_risk",
      "primary_metric": "implementation_shortfall_improvement_bps",
      "benchmark_rule": "improve_arrival_or_vwap_execution_after_costs"
    },
    "hedge_utility": {
      "scorecard": "portfolio_drawdown_and_tail_loss_reduction_net_of_carry_and_false_positive_cost",
      "primary_metric": "drawdown_reduction_per_carry_cost",
      "benchmark_rule": "improve_portfolio_tail_outcome_not_standalone_profit"
    },
    "capital_preservation": {
      "scorecard": "drawdown_avoidance_liquidity_preservation_and_opportunity_cost",
      "primary_metric": "risk_adjusted_opportunity_cost_bps",
      "benchmark_rule": "preserve_capital_relative_to_cash_and_defensive_benchmark"
    },
    "control_only": {
      "scorecard": "prevented_failure_detection_latency_false_positive_rate_and_recovery_time",
      "primary_metric": "control_effectiveness",
      "benchmark_rule": "no_trade_authority_and_no_profitability_claim"
    }
  },
  "contract_defaults": {
    "economic_thesis": "A point-in-time signal must exhibit a repeatable sleeve-specific edge after realistic costs, uncertainty, and risk controls.",
    "universe": "sleeve_manifest_universe",
    "decision_horizon": "sleeve_specific",
    "holding_horizon": "sleeve_specific",
    "entry_rule": "enter_only_after_source_quality_signal_regime_cost_and_risk_qualification",
    "add_rule": "add_only_on_independent_confirmation_with_remaining_risk_budget",
    "trim_rule": "trim_on_edge_decay_concentration_cost_or_risk_budget_pressure",
    "exit_rule": "exit_on_thesis_break_stop_target_or_regime_invalidation",
    "time_stop": "strategy_horizon_specific",
    "label_definition": "candidate_forward_post_cost_outcome_at_contract_horizon_with_point_in_time_features",
    "allowed_regimes": [
      "contract_supported"
    ],
    "blocked_regimes": [
      "source_unverified",
      "cost_unqualified",
      "risk_veto",
      "contract_unsupported"
    ],
    "cost_model": "spread_slippage_fees_market_impact_borrow_funding_and_tax_context_when_applicable",
    "capacity_method": "participation_rate_depth_turnover_concentration_and_impact_curve",
    "benchmark": "sleeve_specific",
    "risk_budget": "candidate_bound_sleeve_budget",
    "shorting_policy": "sleeve_specific",
    "conflict_policy": "portfolio_level_netting_precedence_and_non_bypassable_risk_veto",
    "evidence_policy": "candidate_forward_point_in_time_post_cost_independent_days_and_symbols",
    "lifecycle_policy": "parked_candidate_to_probation_to_validated_candidate_with_watch_demotion_and_retirement_review",
    "runtime_authority": "read_only_metadata_no_decision_authority"
  },
  "derived_sleeve_policy": {
    "purpose": "Complete active collection-sleeve contracts inherit conservative defaults and remain non-executing until an explicit reviewed sleeve override exists.",
    "execution_eligible": false,
    "economic_thesis": "This collection sleeve measures a named market relationship under point-in-time, cost-aware, candidate-bound evaluation before any execution consideration.",
    "universe": "sleeve_manifest_universe",
    "decision_horizon": "research_defined",
    "holding_horizon": "research_defined",
    "benchmark": "matched_asset_class_or_cash_hurdle",
    "risk_budget": "zero_until_explicit_promotion",
    "shorting_policy": "forbidden_until_explicitly_reviewed"
  },
  "sleeves": {
