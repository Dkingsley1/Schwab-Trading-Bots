{
  "schema_version": 1,
  "policy_id": "live_canary_micro_200_v1",
  "status": "advisory_only",
  "account_capital_usd": 200.0,
  "hard_limits": {
    "max_order_notional_usd": 100.0,
    "max_order_quantity": 1.0,
    "max_daily_loss_usd": 2.0,
    "max_cumulative_loss_usd": 10.0,
    "max_concurrent_positions": 1
  },
  "stages": [
    {
      "stage": 1,
      "symbols": ["SCHD"],
      "minimum_successful_reconciled_round_trips": 3
    },
    {
      "stage": 2,
      "symbols": ["SCHD", "SPYD"],
      "minimum_successful_reconciled_round_trips": 6
    },
    {
      "stage": 3,
      "symbols": ["SCHD", "SPYD", "SPYM"],
      "minimum_successful_reconciled_round_trips": 10
    }
  ],
  "required_allowlist_fields": [
    "schema_version",
    "enabled",
    "candidate_id",
    "stage",
    "symbols",
    "issued_at_utc",
    "expires_at_utc"
  ],
  "activation_contract": {
    "create_executable_allowlist_automatically": false,
    "require_exact_candidate_binding": true,
    "require_future_expiration": true,
    "max_allowlist_duration_hours": 4.0,
    "require_production_excellence": true,
    "require_live_transition_integrity": true,
    "require_pinned_account_hash": true,
    "prohibit_account_auto_discovery": true,
    "require_operator_supervision": true,
    "live_execution_authority": false
  }
}
