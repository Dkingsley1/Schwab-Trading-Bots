{
  "schema_version": 1,
  "policy_id": "tiered_ingestion_lifecycle_v1",
  "description": "Read-only lifecycle planning for bounded ingestion segments, compaction, tiering, snapshot retention, and proof-gated retirement.",
  "thresholds": {
    "target_segment_bytes": 268435456,
    "small_segment_max_bytes": 67108864,
    "min_compaction_inputs": 4,
    "max_compaction_inputs": 32,
    "max_compaction_wave_bytes": 8589934592,
    "sealed_min_age_days": 1,
    "cold_after_days": 14,
    "small_segment_soft_count": 512,
    "small_segment_hard_count": 4096,
    "minimum_hot_free_bytes": 21474836480,
    "critical_hot_free_bytes": 10737418240,
    "snapshot_retention_count": 10,
    "orphan_grace_hours": 72
  },
  "generic_compaction_roles": [
    "artifact_store",
    "explainability",
    "explainability_archive",
    "governance_telemetry"
  ],
  "generic_compaction_classifications": [
    "below_manifest_candidate_floor"
  ],
  "protected_classifications": [
    "current_day_hot_path_hold",
    "keep_hot_critical",
    "manifest_index_only",
    "stateful_sql_compaction_only"
  ],
  "design_sources": [
    {
      "system": "Apache Kafka",
      "pattern": "completed segments may move to remote tier while the active local tail remains available under separate local and global retention",
      "url": "https://kafka.apache.org/39/operations/tiered-storage/"
    },
    {
      "system": "Apache Iceberg",
      "pattern": "atomic snapshots, bounded small-file rewrite, snapshot expiration, and orphan cleanup with a safety interval",
      "url": "https://iceberg.apache.org/docs/latest/maintenance/"
    },
    {
      "system": "RocksDB",
      "pattern": "bounded leveled or tiered compaction work controls read, write, and space amplification",
      "url": "https://github.com/facebook/rocksdb/wiki/Compaction"
    },
    {
      "system": "ClickHouse",
      "pattern": "time-based movement across hot, warm, and cold volumes is aligned with background merges",
      "url": "https://clickhouse.com/docs/concepts/features/operations/delete/ttl"
    }
  ],
  "authority": {
    "execution_authority": false,
    "move_authority": false,
    "source_delete_authority": false,
    "intake_throttle_authority": false,
    "live_order_authority": false
  }
}
