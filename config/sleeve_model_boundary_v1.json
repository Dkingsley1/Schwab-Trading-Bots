{
  "schema_version": 1,
  "policy_id": "sleeve_model_boundary_v1",
  "purpose": "Keep full shared market truth available to risk and observability while exposing only sleeve-relevant feature families and explicitly compatible bots at each model boundary.",
  "operating_mode": "enforce_exclusive_domains_preserve_shared_context",
  "feature_projection": {
    "enabled": true,
    "preserve_unclassified": true,
    "always_include_tokens": [
      "account",
      "allocation",
      "broker",
      "candidate",
      "confidence",
      "consensus",
      "cost",
      "cooldown",
      "data_quality",
      "drawdown",
      "exposure",
      "fee",
      "fresh",
      "halt",
      "lane",
      "market_open",
      "master",
      "portfolio",
      "position",
      "regime",
      "risk",
      "score",
      "session",
      "signal",
      "source",
      "threshold",
      "tradeability"
    ],
    "exclusive_groups": [
      "options",
      "crypto",
      "futures"
    ],
    "feature_groups": {
      "market_core": [
        "price",
        "open",
        "high",
        "low",
        "close",
        "return",
        "pct_",
        "mom_",
        "momentum",
        "trend",
        "rsi",
        "macd",
        "atr",
        "volume",
        "realized_volatility"
      ],
      "execution": [
        "quote",
        "bid",
        "ask",
        "spread",
        "slippage",
        "fill",
        "latency",
        "vwap",
        "depth",
        "imbalance",
        "microprice",
        "order_flow",
        "liquidity",
        "execution"
      ],
      "macro": [
        "central_bank",
        "inflation",
        "growth",
        "yield",
        "treasury",
        "rates_",
        "credit",
        "dollar",
        "fx_",
        "monetary",
        "fiscal",
        "employment",
        "gdp",
        "cpi",
        "pce",
        "nfp"
      ],
      "futures": [
        "futures",
        "future_",
        "basis",
        "funding",
        "roll_yield",
        "term_structure",
        "open_interest",
        "auction",
        "contango",
        "backwardation"
      ],
      "options": [
        "option",
        "greek",
        "gamma",
        "delta_",
        "vega",
        "theta",
        "skew",
        "implied_vol",
        "volatility_surface",
        "put_call",
        "strike",
        "expiry"
      ],
      "fundamental": [
        "fundamental",
        "quality",
        "value",
        "dividend",
        "earnings",
        "balance_sheet",
        "cash_flow",
        "revenue",
        "margin",
        "profitability"
      ],
      "event": [
        "event",
        "surprise",
        "news",
        "calendar",
        "announcement"
      ],
      "relative_value": [
        "zscore",
        "cointegration",
        "correlation",
        "residual",
        "hedge_ratio",
        "dislocation",
        "pair_",
        "cross_asset"
      ],
      "crypto": [
        "crypto",
        "bitcoin",
        "btc_",
        "ethereum",
        "eth_",
        "perpetual",
        "onchain",
        "chain_",
        "cross_venue"
      ],
      "sentiment": [
        "sentiment",
        "nlp",
        "social",
        "tone"
      ],
      "research": [
        "model_",
        "uncertainty",
        "causal",
        "state_space",
        "quant_",
        "neural",
        "feature_quality"
      ],
      "infrastructure": [
        "runtime",
        "storage",
        "backlog",
        "process",
        "memory",
        "cpu_",
        "network",
        "throttle",
        "ingestion",
        "collector",
        "auth_lease"
      ]
    },
    "family_allowed_groups": {
      "balanced_directional": ["market_core", "execution", "macro", "fundamental", "event", "relative_value", "sentiment"],
      "long_horizon_income": ["market_core", "execution", "macro", "fundamental", "event", "sentiment"],
      "intraday_momentum": ["market_core", "execution", "macro", "event", "relative_value", "sentiment"],
      "swing_directional": ["market_core", "execution", "macro", "fundamental", "event", "relative_value", "sentiment"],
      "relative_value": ["market_core", "execution", "macro", "relative_value", "event"],
      "volatility_derivatives": ["market_core", "execution", "macro", "options", "futures", "event", "relative_value"],
      "liquidity_microstructure": ["market_core", "execution", "macro", "event", "relative_value"],
      "event_driven": ["market_core", "execution", "macro", "fundamental", "event", "sentiment"],
      "macro_rates_fx": ["market_core", "execution", "macro", "event", "relative_value"],
      "commodity_inflation": ["market_core", "execution", "macro", "event", "relative_value"],
      "digital_asset_basis": ["market_core", "execution", "macro", "crypto", "futures", "event", "relative_value", "sentiment"],
      "tail_hedge": ["market_core", "execution", "macro", "options", "futures", "event", "relative_value"],
      "structured_credit": ["market_core", "execution", "macro", "options", "event", "relative_value"],
      "research_models": ["market_core", "execution", "macro", "futures", "options", "fundamental", "event", "relative_value", "crypto", "sentiment", "research"],
      "infrastructure_control": ["execution", "infrastructure", "research"]
    },
    "profile_group_additions": {
      "schwab_futures": ["futures"],
      "futures_index_intraday": ["futures"],
      "futures_rates_curve": ["futures"],
      "futures_commodity_macro": ["futures"],
      "futures_event_reaction": ["futures"],
      "options_on_futures": ["options", "futures"],
      "options_on_futures_aggressive": ["options", "futures"],
      "single_name_options_event": ["options"]
    }
  },
  "bot_scope": {
    "enabled": true,
    "unscoped_policy": "allow_with_audit",
    "same_family_allowed": true,
    "exact_profile_allowed": true,
    "always_allowed_roles": ["infrastructure_bot", "infrastructure_sub_bot"],
    "role_family_allowlist": {
      "options_sub_bot": ["volatility_derivatives", "event_driven", "tail_hedge", "structured_credit", "relative_value", "research_models"],
      "futures_sub_bot": ["intraday_momentum", "macro_rates_fx", "commodity_inflation", "digital_asset_basis", "volatility_derivatives", "relative_value", "tail_hedge", "research_models"],
      "crypto_sub_bot": ["digital_asset_basis", "relative_value", "research_models"],
      "macro_sub_bot": ["balanced_directional", "long_horizon_income", "intraday_momentum", "swing_directional", "relative_value", "volatility_derivatives", "liquidity_microstructure", "event_driven", "macro_rates_fx", "commodity_inflation", "digital_asset_basis", "tail_hedge", "structured_credit", "research_models"]
    }
  },
  "authority": {
    "preserves_full_observability_snapshot": true,
    "can_create_intent": false,
    "can_reverse_intent": false,
    "can_increase_quantity": false,
    "can_change_risk_limits": false,
    "can_submit_paper_order": false,
    "can_submit_live_order": false,
    "can_grant_promotion": false
  }
}
