{
  "schema_version": 1,
  "policy_id": "investor_readiness_v1",
  "control_policy": "investor_readiness_requires_separate_implementation_organic_live_and_external_evidence",
  "maximum_shortlisted_sleeves": 3,
  "controls": [
    {
      "control_id": "i01_broker_verified_live_results",
      "section": "investor_due_diligence",
