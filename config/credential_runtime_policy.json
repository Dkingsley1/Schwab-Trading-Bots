{
  "schema_version": 1,
  "interactive_credential_entry": true,
  "interactive_credential_command": "./scripts/ops/opsctl.sh schwab-credentials --interactive --store keychain --json",
  "secret_store_preference": ["macos_keychain", "encrypted_local_secret_file", "ci_secret_context"],
  "forbidden_secret_locations": ["shell_history", "logs", "governance", "exports", "repo_source"],
  "token_lease_monitor": {
    "enabled": true,
    "min_refresh_lead_seconds": 1800,
    "critical_expiry_seconds": 600,
    "incident_artifact": "governance/health/broker_auth_incident_latest.json",
    "ready_artifact": "governance/health/schwab_auth_ready_latest.json"
  },
  "manual_reauth_contract": {
    "allowed": true,
    "requires_private_operator_surface": true,
    "must_not_log_credentials": true,
    "must_emit_incident_state": true
  },
  "production_live_canary_contract": {
    "requires_token_lease_ready": true,
    "unknown_auth_state_blocks_orders": true,
    "expired_or_unprobed_auth_blocks_orders": true
  }
}
