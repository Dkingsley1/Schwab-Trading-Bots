{
  "schema_version": 1,
  "policy_id": "authoritative_systems_v1",
  "purpose": "Translate public primary-source design patterns into locally owned, testable controls without treating source count as trading evidence or granting execution authority.",
  "authority": {
    "influence_only": true,
    "can_create_order_intent": false,
    "can_change_signal": false,
    "can_change_quantity": false,
    "can_change_risk_limits": false,
    "can_promote_live": false,
    "can_submit_live_order": false
  },
  "required_control_ids": [
    "broker_capability_conformance",
    "order_state_idempotency",
    "point_in_time_validity",
    "event_time_watermarks",
    "causal_attribution",
    "paper_live_equivalence",
    "execution_fault_simulation",
    "end_to_end_traceability"
  ],
  "controls": {
    "broker_capability_conformance": {
      "owner": "core/brokers/capability_contract.py",
      "test": "tests/test_broker_capability_contract.py",
      "description": "Separate market-data, paper, live, asset-class, order-type, time-in-force, precision, and production eligibility claims."
    },
    "order_state_idempotency": {
      "owner": "core/live_order_ledger.py",
      "test": "tests/test_live_order_ledger.py",
      "description": "Persist legal order transitions, immutable broker identity, monotonic fills, terminal-state immutability, and duplicate-submit protection."
    },
    "point_in_time_validity": {
      "owner": "core/strategy_validity.py",
      "test": "tests/test_strategy_validity.py",
      "description": "Reject high-confidence lookahead patterns and prove suffix invariance and recursive warmup stability.",
      "scan_paths": [
        "core/base_trader.py",
        "core/institutional_decision_flow.py",
        "core/profitability_hardening.py",
        "core/sleeve_strategy_specialization.py",
        "scripts/run_shadow_training_loop.py",
        "scripts/paper_performance_report.py",
        "scripts/quantitative_challenger_report.py"
      ]
    },
    "event_time_watermarks": {
      "owner": "core/event_time_control.py",
      "test": "tests/test_event_time_control.py",
      "description": "Classify bounded out-of-order events, quarantine late or future-skewed events, and restore deterministic watermarks."
    },
    "causal_attribution": {
      "owner": "core/causal_attribution.py",
      "test": "tests/test_causal_attribution.py",
      "description": "Attribute signal, sizing, risk, execution, cost, and outcome observations without inventing unavailable values."
    },
    "paper_live_equivalence": {
      "owner": "core/paper_live_equivalence.py",
      "test": "tests/test_paper_live_equivalence.py",
      "description": "Compare mode-invariant intent semantics while explicitly allowing broker fill and latency differences."
    },
    "execution_fault_simulation": {
      "owner": "core/execution_scenarios.py",
      "test": "tests/test_execution_scenarios.py",
      "description": "Exercise latency, submit disconnect, duplicate intent, progressive partial fill, halt, gap, and cancel-race behavior."
    },
    "end_to_end_traceability": {
      "owner": "core/causal_attribution.py",
      "test": "tests/test_causal_attribution.py",
      "description": "Carry deterministic trace identity and a hash-linked source-to-outcome stage chain in existing execution artifacts."
    }
  },
