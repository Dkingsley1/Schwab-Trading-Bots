{
  "schema_version": 1,
  "policy_id": "authoritative_systems_v1",
  "purpose": "Translate public primary-source design patterns into locally owned, testable controls without treating source count as trading evidence or granting execution authority.",
  "authority": {
    "influence_only": true,
    "can_create_order_intent": false,
    "can_change_signal": false,
    "can_change_quantity": false,
    "can_change_risk_limits": false,
    "can_promote_live": false,
    "can_submit_live_order": false
  },
  "required_control_ids": [
    "broker_capability_conformance",
    "order_state_idempotency",
    "point_in_time_validity",
    "event_time_watermarks",
    "causal_attribution",
    "paper_live_equivalence",
    "execution_fault_simulation",
    "end_to_end_traceability",
    "exchange_sequence_integrity",
    "atomic_archive_snapshots",
    "formal_safety_specification",
    "build_provenance_attestation",
    "canonical_trade_lifecycle",
    "independent_pricing_risk_oracle",
    "constrained_portfolio_advisory",
    "declarative_data_quality",
    "research_data_platform_contract",
    "institutional_research_extensions_contract"
  ],
  "controls": {
    "broker_capability_conformance": {
      "owner": "core/brokers/capability_contract.py",
      "test": "tests/test_broker_capability_contract.py",
      "description": "Separate market-data, paper, live, asset-class, order-type, time-in-force, precision, and production eligibility claims."
    },
    "order_state_idempotency": {
      "owner": "core/live_order_ledger.py",
      "test": "tests/test_live_order_ledger.py",
      "description": "Persist legal order transitions, immutable broker identity, monotonic fills, terminal-state immutability, duplicate-submit protection, startup recovery, and reconciliation-only handling after ambiguous broker mutations."
    },
    "point_in_time_validity": {
      "owner": "core/strategy_validity.py",
      "test": "tests/test_strategy_validity.py",
      "description": "Reject high-confidence lookahead patterns and prove suffix invariance and recursive warmup stability.",
      "scan_paths": [
        "core/base_trader.py",
        "core/institutional_decision_flow.py",
        "core/profitability_hardening.py",
        "core/sleeve_strategy_specialization.py",
        "scripts/run_shadow_training_loop.py",
        "scripts/paper_performance_report.py",
        "scripts/quantitative_challenger_report.py"
      ]
    },
    "event_time_watermarks": {
      "owner": "core/event_time_control.py",
      "test": "tests/test_event_time_control.py",
      "description": "Classify bounded out-of-order events, quarantine late or future-skewed events, and restore deterministic watermarks."
    },
    "causal_attribution": {
      "owner": "core/causal_attribution.py",
      "test": "tests/test_causal_attribution.py",
      "description": "Attribute signal, sizing, risk, execution, cost, and outcome observations without inventing unavailable values."
    },
    "paper_live_equivalence": {
      "owner": "core/paper_live_equivalence.py",
      "test": "tests/test_paper_live_equivalence.py",
      "description": "Compare mode-invariant intent semantics while explicitly allowing broker fill and latency differences."
    },
    "execution_fault_simulation": {
      "owner": "core/execution_scenarios.py",
      "test": "tests/test_execution_scenarios.py",
      "description": "Exercise latency, submit disconnect, duplicate intent, progressive partial fill, halt, gap, and cancel-race behavior."
    },
    "end_to_end_traceability": {
      "owner": "core/causal_attribution.py",
      "test": "tests/test_causal_attribution.py",
      "description": "Carry deterministic trace identity and a hash-linked source-to-outcome stage chain in existing execution artifacts."
    },
    "exchange_sequence_integrity": {
      "owner": "core/exchange_sequence_control.py",
      "test": "tests/test_exchange_sequence_control.py",
      "description": "Apply explicit channel, session, sequence-gap, duplicate-conflict, recovery-range, and deterministic restore semantics without claiming native ITCH or OUCH connectivity."
    },
    "atomic_archive_snapshots": {
      "owner": "core/archive_snapshot_control.py",
      "test": "tests/test_archive_snapshot_control.py",
      "description": "Hash archive manifests, compare-and-swap snapshot heads, preserve readable lineage, and require verified replacement before any source retirement."
    },
    "formal_safety_specification": {
      "owner": "core/formal_safety_invariants.py",
      "test": "tests/test_formal_safety_invariants.py",
      "description": "Mirror order safety invariants in a bounded executable model and a TLA+ specification while keeping TLC execution and independent review as explicit proof debt."
    },
    "build_provenance_attestation": {
      "owner": "core/build_provenance.py",
      "test": "tests/test_build_provenance.py",
      "description": "Produce and verify SLSA-shaped subject and material digests without treating an unsigned local statement as trusted CI provenance."
    },
    "canonical_trade_lifecycle": {
      "owner": "core/trade_lifecycle.py",
      "test": "tests/test_trade_lifecycle.py",
      "description": "Enforce immutable product economics and hash-linked execution, confirmation, allocation, settlement, exercise, expiration, and cancellation transitions."
    },
    "independent_pricing_risk_oracle": {
      "owner": "core/independent_risk_oracle.py",
      "test": "tests/test_independent_risk_oracle.py",
      "description": "Reconcile candidate-bound valuation and risk measures against a distinct signed provider while ensuring synthetic probes never become independent evidence."
    },
    "constrained_portfolio_advisory": {
      "owner": "core/portfolio_advisory.py",
      "test": "tests/test_portfolio_advisory.py",
      "description": "Build candidate-bound multi-period advisory weights only from mature low-correlation sleeves under cash, concentration, turnover, and post-cost edge constraints."
    },
    "declarative_data_quality": {
      "owner": "core/data_quality_checkpoints.py",
      "test": "tests/test_data_quality_checkpoints.py",
      "description": "Run declarative schema, type, range, uniqueness, monotonicity, future-time, and freshness checks with row quarantine and fail-closed actions."
    },
    "research_data_platform_contract": {
      "owner": "core/research_data_platform.py",
      "test": "tests/test_research_data_platform.py",
      "description": "Unify catalog, permitted use, point-in-time access, bitemporal revisions, alpha lifecycle, source value, portfolio advisory, simulation semantics, feed SLOs, and reproducibility without granting trading authority."
    },
    "institutional_research_extensions_contract": {
      "owner": "core/institutional_research_extensions.py",
      "test": "tests/test_institutional_research_extensions.py",
      "description": "Join factor benchmarks, pipeline incident ownership, material-change review, candidate risk schedules, execution speed-cost frontiers, checkpointable research DAGs, versioned datasets, and cross-engine valuation without granting trading authority."
    }
  },
