{
  "schema_version": 1,
  "policy_id": "candidate_bound_alpha_concept_registry_v1",
  "operating_mode": "paper_only_read_only_alpha_measurement_laboratory",
  "objective": "Measure, route, and expose materially useful alpha concepts without confusing catalog coverage, implemented mathematics, wired evidence, or economic support.",
  "scope_contract": {
    "finite_architecture_specific_ontology": true,
    "claims_to_enumerate_every_possible_alpha_concept": false,
    "inclusion_rule": "Include concepts that can improve forecast measurement, point-in-time validity, causal robustness, post-cost economics, diversification, execution, capacity, adaptation, or risk control for at least one governed sleeve.",
    "duplicate_strategy_instances_created": false,
    "cold_research_concepts_may_execute": false
  },
  "authority": {
    "changes_active_action": false,
    "changes_position_size": false,
    "changes_allocator_weights": false,
    "changes_training_labels": false,
    "submits_paper_orders": false,
    "submits_live_orders": false,
    "grants_promotion": false,
    "mutates_candidate": false,
    "rewrites_history": false,
    "guarantees_profitability": false
  },
  "candidate_binding": {
    "required": true,
    "candidate_state_path": "governance/runtime/production_candidate_state.json",
    "paper_performance_path": "governance/health/paper_performance_latest.json",
    "measurement_inputs_path": "governance/research/alpha_concept_inputs_latest.json",
    "allow_historical_fallback": false,
    "allow_cross_candidate_pooling": false,
    "require_candidate_filter_active": true,
    "require_zero_mismatch_rows": true,
    "require_post_cutoff_watermark": true
  },
  "measurement_engines": {
    "information_coefficient_term_structure": {
      "function": "information_coefficient_term_structure",
      "minimum_observations_per_horizon": 20,
      "minimum_periods_for_icir": 5,
      "concept_ids": [
        "information_coefficient_term_structure",
        "rank_information_coefficient",
        "information_coefficient_information_ratio"
      ]
    },
    "effective_breadth_transfer_coefficient": {
      "function": "effective_breadth_transfer_coefficient",
      "minimum_periods": 12,
      "minimum_bets": 2,
      "concept_ids": [
        "effective_breadth",
        "transfer_coefficient"
      ]
    },
    "hierarchical_bayesian_skill": {
      "function": "hierarchical_bayesian_skill",
      "minimum_groups": 2,
      "minimum_observations_per_group": 8,
      "posterior_probability_floor": 0.95,
      "concept_ids": [
        "hierarchical_bayesian_skill"
      ]
    },
    "subsample_stability_selection": {
      "function": "subsample_stability_selection",
      "minimum_observations": 30,
      "replications": 200,
      "subsample_fraction": 0.5,
      "selection_probability_floor": 0.8,
      "sign_consistency_floor": 0.8,
      "seed": 1777,
      "concept_ids": [
        "stability_selection"
      ]
    },
    "economic_alpha_decomposition": {
      "function": "economic_alpha_decomposition",
      "minimum_observations": 20,
      "ridge_penalty": 1E-8,
      "concept_ids": [
        "economic_alpha_decomposition",
        "selection_alpha_attribution",
        "timing_alpha_attribution"
      ]
    },
    "factor_neutral_residualization": {
      "function": "factor_neutral_residualization",
      "minimum_observations": 20,
      "ridge_penalty": 1E-8,
      "concept_ids": [
        "full_multifactor_residual_alpha",
        "market_beta_residual",
        "sector_industry_neutralization",
        "macro_factor_residual"
      ]
    },
    "cross_fitted_causal_transportability": {
      "function": "cross_fitted_causal_transportability",
      "minimum_observations": 40,
      "minimum_environments": 2,
      "ridge_penalty": 0.001,
      "maximum_relative_heterogeneity": 1.0,
      "concept_ids": [
        "cross_fitted_dml",
        "transportability_stress"
      ]
    },
    "capacity_impact_surface": {
      "function": "capacity_impact_surface",
      "minimum_surface_points": 3,
      "impact_exponent": 0.5,
      "concept_ids": [
        "endogenous_capacity_impact",
        "capacity_adjusted_net_alpha"
      ]
    },
    "execution_alpha_attribution": {
      "function": "execution_alpha_attribution",
      "minimum_fills": 1,
      "concept_ids": [
        "execution_alpha_attribution",
        "execution_component_attribution"
      ]
    },
    "point_in_time_security_master_audit": {
      "function": "point_in_time_security_master_audit",
      "minimum_identifier_coverage_ratio": 1.0,
      "minimum_observation_resolution_ratio": 1.0,
      "concept_ids": [
        "point_in_time_security_master",
        "survivorship_delisting_control",
        "corporate_action_adjustment"
      ]
    },
    "split_conformal_residual_calibration": {
      "function": "split_conformal_residual_calibration",
      "minimum_observations": 30,
      "calibration_fraction": 0.6,
      "miscoverage_alpha": 0.1,
      "coverage_tolerance": 0.05,
      "maximum_width_to_outcome_scale": 2.0,
      "concept_ids": [
        "conformal_abstention"
      ]
    },
    "sequential_change_point_stability": {
      "function": "sequential_change_point_stability",
      "minimum_observations_per_group": 30,
      "minimum_groups": 1,
      "burn_in_observations": 10,
      "drift_delta_standard_deviations": 0.05,
      "alarm_threshold_standard_deviations": 5.0,
      "recent_window_observations": 10,
      "minimum_stability_score": 0.7,
      "concept_ids": [
        "online_changepoint",
        "feature_decay_monitoring"
      ]
    },
    "residual_redundancy_graph": {
      "function": "residual_redundancy_graph",
      "minimum_common_observations": 20,
      "minimum_groups": 2,
      "absolute_correlation_threshold": 0.7,
      "minimum_independent_group_ratio": 0.5,
      "concept_ids": [
        "ensemble_diversity",
        "crowding_flow_residual"
      ]
    },
    "regime_conditional_robustness": {
      "function": "regime_conditional_robustness",
      "minimum_regimes": 2,
      "minimum_observations_per_regime": 10,
      "minimum_supported_regime_ratio": 0.67,
      "minimum_mean_lcb": 0.0,
      "concept_ids": [
        "hidden_state_regime",
        "volatility_regime",
        "correlation_break"
      ]
    },
    "cost_stress_survival": {
      "function": "cost_stress_survival",
      "uncertainty_buffer_bps": 0.0,
      "cost_multipliers": [
        1.0,
        1.25,
        1.5,
        2.0
      ],
      "minimum_positive_scenario_ratio": 0.75,
      "concept_ids": [
        "turnover_aware_optimization",
        "capacity_adjusted_net_alpha"
      ]
    },
    "active_learning_value_of_information": {
      "function": "active_learning_value_of_information",
      "minimum_gaps": 1,
      "concept_ids": [
        "active_learning_value_of_information"
      ]
    }
  },
