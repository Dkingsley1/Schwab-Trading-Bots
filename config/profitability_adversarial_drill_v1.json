    {
      "scenario_id": "regime_transition_whipsaw",
      "aliases": ["whipsaw", "regime_transition"],
      "title": "Regime transition and whipsaw",
      "purpose": "Verify that low-quality transition signals are suppressed without preventing confirmed recovery re-entry."
    },
    {
      "scenario_id": "net_alpha_break_even_ladder",
      "aliases": ["break_even", "cost_ladder"],
      "title": "Net-alpha break-even ladder",
      "purpose": "Locate the modeled cost boundary where a positive gross signal is no longer eligible after costs."
    },
    {
      "scenario_id": "capital_capacity_scaling",
      "aliases": ["capacity", "capital_scaling"],
      "title": "Capital and capacity scaling",
      "purpose": "Measure sleeve-aware diagnostic capacity from a 200-dollar canary through one billion dollars under six market states."
    },
    {
      "scenario_id": "liquidity_evaporation_partial_fill",
      "aliases": ["liquidity_evaporation", "partial_fill_inventory"],
      "title": "Liquidity evaporation after a partial fill",
      "purpose": "Verify that disappearing depth blocks additional exposure while preserving a reduce-only inventory exit."
    },
    {
      "scenario_id": "correlation_crowding_collapse",
      "aliases": ["crowding", "correlation_collapse"],
      "title": "Correlation and crowding collapse",
      "purpose": "Verify that sleeves which become one factor are not treated as independent portfolio bets."
    },
    {
      "scenario_id": "gradual_strategy_decay",
      "aliases": ["strategy_decay", "concept_drift"],
      "title": "Gradual strategy decay",
      "purpose": "Detect a slowly eroding edge while preserving a stable control series."
    },
    {
      "scenario_id": "point_in_time_contamination",
      "aliases": ["point_in_time", "revision_leakage"],
      "title": "Point-in-time contamination and revisions",
      "purpose": "Prove that future revisions and not-yet-known observations cannot enter an earlier decision replay."
    },
    {
      "scenario_id": "recovery_reentry_timing",
      "aliases": ["reentry", "recovery_timing"],
      "title": "Recovery re-entry timing",
      "purpose": "Compare immediate, staged, and delayed recovery paths after costs and drawdown penalties."
    },
    {
      "scenario_id": "benchmark_opportunity_cost",
      "aliases": ["opportunity_cost", "benchmark_hold"],
      "title": "Benchmark-relative opportunity cost",
      "purpose": "Separate prudent abstention from costly inactivity against cash, SGOV, and passive exposure."
    },
    {
      "scenario_id": "signal_horizon_conflict",
      "aliases": ["horizon_conflict", "sleeve_ownership"],
      "title": "Signal horizon conflict",
      "purpose": "Keep intraday, swing, and long-horizon evidence inside the sleeve that owns that horizon."
    },
    {
      "scenario_id": "corporate_action_calendar",
      "aliases": ["corporate_actions", "calendar_boundaries"],
      "title": "Corporate actions and market-calendar boundaries",
      "purpose": "Preserve security identity and accounting across splits, dividends, symbol changes, delistings, options adjustments, DST, half-days, and futures rolls."
    },
    {
      "scenario_id": "volatility_dependent_data_loss",
      "aliases": ["mnar", "volatile_data_loss"],
      "title": "Volatility-dependent missing data",
      "purpose": "Detect data that disappears specifically in turbulent periods and prevent stale last-good evidence from masquerading as current."
    },
    {
      "scenario_id": "false_model_consensus",
      "aliases": ["false_consensus", "model_redundancy"],
      "title": "False model consensus",
      "purpose": "Collapse correlated model votes into independent evidence components before counting consensus."
    },
    {
      "scenario_id": "portfolio_path_dependency",
      "aliases": ["path_dependency", "same_endpoint"],
      "title": "Portfolio path dependency",
      "purpose": "Prove that equal endpoint returns can carry materially different drawdown and stop behavior."
    }
  ],
