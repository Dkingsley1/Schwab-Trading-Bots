{
  "schema_version": 1,
  "policy_id": "system_responsibility_and_authority_v1",
  "operating_mode": "enforced_responsibility_contracts",
  "required_role_fields": [
    "role_id",
    "display_name",
    "tier",
    "purpose",
    "allowed_inputs",
    "owned_outputs",
    "write_authority",
    "execution_authority",
    "triggers",
    "freshness_slo",
    "failure_behavior",
    "resource_budget",
    "escalation_owner",
    "evidence_outputs",
    "forbidden_actions",
    "allowed_actions"
  ],
  "taxonomies": {
    "execution_modes": [
      {"id": "observe", "order_authority": false},
      {"id": "recommend", "order_authority": false},
      {"id": "paper", "order_authority": "paper_only"},
      {"id": "live", "order_authority": "explicit_candidate_bound_only"}
    ],
    "freshness_classes": [
      {"id": "realtime", "default_max_age_seconds": 15},
      {"id": "near_realtime", "default_max_age_seconds": 300},
      {"id": "operational", "default_max_age_seconds": 900},
      {"id": "daily", "default_max_age_seconds": 86400},
      {"id": "immutable", "default_max_age_seconds": 315360000}
    ],
    "failure_classes": [
      {"id": "isolate_source", "default_action": "quarantine_affected_source"},
      {"id": "abstain", "default_action": "emit_no_trade_or_no_decision"},
      {"id": "fail_closed", "default_action": "deny_mutation"},
      {"id": "bounded_repair", "default_action": "repair_with_cooldown_and_circuit"},
      {"id": "escalate", "default_action": "require_operator_review"}
    ],
    "resource_profiles": [
      {"id": "io_light", "priority": "utility", "max_parallelism": 4},
      {"id": "compute_bounded", "priority": "utility", "max_parallelism": 2},
      {"id": "latency_sensitive", "priority": "high", "max_parallelism": 1},
      {"id": "single_flight_heavy", "priority": "background", "max_parallelism": 1},
      {"id": "control_plane", "priority": "high", "max_parallelism": 1}
    ],
    "lifecycle_states": [
      "defined",
      "shadow",
      "paper_eligible",
      "paper_active",
      "promotion_review",
      "live_canary_eligible",
      "quarantined",
      "retired"
    ],
    "configuration_precedence": [
      "safety_flags",
      "candidate_bound_runtime_state",
      "operator_override",
      "runtime_profile",
      "policy_json",
      "environment_default",
      "code_default"
    ],
    "severity_classes": [
      "info",
      "watch",
      "degraded",
      "blocked",
      "critical"
    ],
    "action_classes": {
      "read_only": ["collect_data", "normalize_context", "score_signal"],
      "data_mutation": ["append_observation", "publish_context"],
      "advisory": ["recommend_trade", "aggregate_signal", "allocate_shadow_weight", "emit_order_intent", "rank_sleeves", "allocate_shadow_capital", "coordinate_policy"],
      "governance": ["validate_evidence", "validate_authority", "classify_bot", "publish_evidence", "set_risk_limit", "promote_candidate", "write_candidate_state"],
      "execution": ["paper_submit", "live_submit", "veto_trade", "record_execution_attempt"],
      "truth": ["record_truth", "reconcile_broker"],
      "operations": ["emit_health", "report_health", "publish_dashboard", "write_state", "manage_storage", "manage_artifact_lifecycle", "restart_process", "repair_infrastructure"],
      "research": ["train_model", "publish_model_candidate"]
    }
  },
  "hierarchy": {
    "planes": {
      "data_plane": ["data_collector", "context_processor"],
      "decision_plane": ["strategy_bot", "sleeve_manager", "master_coordinator", "grand_master_coordinator"],
      "control_plane": ["risk_governance", "promotion_governance"],
      "execution_plane": ["paper_execution_gateway", "live_execution_gateway"],
      "truth_plane": ["truth_reconciliation"],
      "operations_plane": ["infrastructure_maintainer", "observability_reporter", "training_research", "evaluation_auditor"]
    },
    "decision_flow": [
      "data_collector",
      "context_processor",
      "strategy_bot",
      "sleeve_manager",
      "master_coordinator",
      "grand_master_coordinator",
      "risk_governance",
      "paper_execution_gateway",
      "live_execution_gateway",
      "truth_reconciliation"
    ],
    "non_bypassable_roles": [
      "risk_governance",
      "live_execution_gateway",
      "truth_reconciliation"
    ],
    "rules": {
      "collectors_never_decide_or_trade": true,
      "strategies_never_submit_orders": true,
      "masters_never_bypass_risk": true,
      "risk_may_veto_but_never_originate_signals": true,
      "execution_is_the_only_order_writer": true,
      "truth_never_rewrites_outcomes": true,
      "infrastructure_never_changes_trade_logic": true,
      "dashboards_never_invent_canonical_truth": true,
      "grand_master_cannot_grant_itself_authority": true
    }
  },
  "roles": [
    {
      "role_id": "data_collector",
      "display_name": "Data Collector",
      "tier": "data_plane_ingress",
      "purpose": "Acquire, timestamp, validate, and append source observations with provenance.",
      "allowed_inputs": ["approved_external_sources", "broker_market_data", "collector_schedule", "symbol_universe"],
      "owned_outputs": ["raw_observation_events", "source_health_evidence"],
      "write_authority": ["append_only_raw_observation_events"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["scheduled_poll", "provider_event", "market_session_event"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 600},
      "failure_behavior": {"class": "isolate_source", "default_action": "quarantine_affected_source_and_preserve_last_good"},
      "resource_budget": {"profile": "io_light", "max_parallelism": 8, "memory_mb_soft": 1024},
      "escalation_owner": "infrastructure_maintainer",
      "evidence_outputs": ["source_provenance_receipt", "collector_heartbeat", "schema_validation_result"],
      "forbidden_actions": ["recommend_trade", "emit_order_intent", "paper_submit", "live_submit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["collect_data", "append_observation", "emit_health"]
    },
    {
      "role_id": "context_processor",
      "display_name": "Context Processor",
      "tier": "data_plane_context",
      "purpose": "Normalize and synchronize macro, micro, event, regime, and market context without creating order authority.",
      "allowed_inputs": ["raw_observation_events", "approved_reference_data", "point_in_time_lineage"],
      "owned_outputs": ["canonical_context_snapshot", "context_provenance"],
      "write_authority": ["canonical_context_snapshot"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["new_observation_batch", "scheduled_context_refresh"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 600},
      "failure_behavior": {"class": "fail_closed", "default_action": "mark_context_unknown_and_exclude_dependent_decisions"},
      "resource_budget": {"profile": "compute_bounded", "max_parallelism": 2, "memory_mb_soft": 1536},
      "escalation_owner": "infrastructure_maintainer",
      "evidence_outputs": ["context_lineage_receipt", "source_alignment_report", "freshness_report"],
      "forbidden_actions": ["emit_order_intent", "paper_submit", "live_submit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["normalize_context", "publish_context", "emit_health"]
    },
    {
      "role_id": "strategy_bot",
      "display_name": "Strategy Bot",
      "tier": "decision_plane_hypothesis",
      "purpose": "Produce scored, attributable market hypotheses within a declared sleeve and regime mandate.",
      "allowed_inputs": ["canonical_context_snapshot", "approved_features", "model_artifact", "read_only_metadata"],
      "owned_outputs": ["strategy_signal_events", "strategy_explanation"],
      "write_authority": ["append_only_strategy_signal_events"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["feature_snapshot_ready", "strategy_schedule"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 900},
      "failure_behavior": {"class": "abstain", "default_action": "emit_no_signal_and_quarantine_invalid_model"},
      "resource_budget": {"profile": "compute_bounded", "max_parallelism": 4, "memory_mb_soft": 2048},
      "escalation_owner": "sleeve_manager",
      "evidence_outputs": ["signal_provenance", "confidence_score", "regime_compatibility", "feature_receipt"],
      "forbidden_actions": ["paper_submit", "live_submit", "set_risk_limit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["score_signal", "recommend_trade", "emit_health"]
    },
    {
      "role_id": "sleeve_manager",
      "display_name": "Sleeve Manager",
      "tier": "decision_plane_sleeve",
      "purpose": "Aggregate specialized strategy evidence within one mandate and emit bounded order intentions.",
      "allowed_inputs": ["strategy_signal_events", "canonical_context_snapshot", "sleeve_policy", "risk_read_only_limits"],
      "owned_outputs": ["sleeve_order_intents", "sleeve_consensus_evidence"],
      "write_authority": ["append_only_sleeve_order_intents"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["strategy_batch_ready", "sleeve_schedule"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 900},
      "failure_behavior": {"class": "abstain", "default_action": "abstain_when_diversity_or_confidence_is_insufficient"},
      "resource_budget": {"profile": "compute_bounded", "max_parallelism": 2, "memory_mb_soft": 1024},
      "escalation_owner": "master_coordinator",
      "evidence_outputs": ["consensus_receipt", "diversity_score", "weight_cap_events"],
      "forbidden_actions": ["paper_submit", "live_submit", "bypass_risk", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["aggregate_signal", "allocate_shadow_weight", "emit_order_intent", "emit_health"]
    },
    {
      "role_id": "master_coordinator",
      "display_name": "Master Coordinator",
      "tier": "decision_plane_master",
      "purpose": "Rank sleeves and coordinate shadow or paper recommendations without bypassing governance.",
      "allowed_inputs": ["sleeve_order_intents", "sleeve_evidence", "portfolio_context", "risk_read_only_limits"],
      "owned_outputs": ["master_allocation_plan", "ranked_sleeve_recommendations"],
      "write_authority": ["master_allocation_plan"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["sleeve_consensus_ready", "allocation_cycle"],
      "freshness_slo": {"class": "operational", "max_age_seconds": 1800},
      "failure_behavior": {"class": "abstain", "default_action": "retain_last_safe_allocation_and_emit_no_new_intent"},
      "resource_budget": {"profile": "control_plane", "max_parallelism": 1, "memory_mb_soft": 1024},
      "escalation_owner": "grand_master_coordinator",
      "evidence_outputs": ["allocation_receipt", "ranking_explanation", "constraint_report"],
      "forbidden_actions": ["paper_submit", "live_submit", "bypass_risk", "self_promote", "rewrite_truth"],
      "allowed_actions": ["rank_sleeves", "allocate_shadow_capital", "recommend_trade", "emit_health"]
    },
    {
      "role_id": "grand_master_coordinator",
      "display_name": "Grand Master Coordinator",
      "tier": "decision_plane_global",
      "purpose": "Coordinate global policy, resource allocation, and cross-sleeve priorities without granting execution authority.",
      "allowed_inputs": ["master_allocation_plan", "portfolio_context", "system_health", "governance_policy"],
      "owned_outputs": ["global_coordination_policy", "cross_sleeve_priority_packet"],
      "write_authority": ["global_coordination_policy"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["master_plan_ready", "global_policy_cycle"],
      "freshness_slo": {"class": "operational", "max_age_seconds": 3600},
      "failure_behavior": {"class": "escalate", "default_action": "freeze_new_allocations_and_require_operator_review"},
      "resource_budget": {"profile": "control_plane", "max_parallelism": 1, "memory_mb_soft": 1024},
      "escalation_owner": "operator",
      "evidence_outputs": ["global_policy_receipt", "cross_sleeve_conflict_report", "resource_allocation_receipt"],
      "forbidden_actions": ["paper_submit", "live_submit", "grant_execution_authority", "self_promote", "rewrite_truth"],
      "allowed_actions": ["coordinate_policy", "rank_sleeves", "recommend_trade", "emit_health"]
    },
    {
      "role_id": "risk_governance",
      "display_name": "Risk and Governance",
      "tier": "control_plane_risk",
      "purpose": "Apply non-bypassable limits, approve or veto intentions, and fail closed on ambiguous risk state.",
      "allowed_inputs": ["order_intents", "portfolio_truth", "risk_policy", "candidate_state", "system_health"],
      "owned_outputs": ["risk_decision_state", "veto_events", "effective_risk_limits"],
      "write_authority": ["risk_decision_state"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": true, "live_submit": false, "automatic_promotion": false},
      "triggers": ["order_intent_received", "risk_state_changed", "halt_event"],
      "freshness_slo": {"class": "realtime", "max_age_seconds": 15},
      "failure_behavior": {"class": "fail_closed", "default_action": "deny_new_risk_and_preserve_verified_risk_reduction"},
      "resource_budget": {"profile": "latency_sensitive", "max_parallelism": 1, "memory_mb_soft": 512},
      "escalation_owner": "operator",
      "evidence_outputs": ["risk_decision_receipt", "limit_snapshot", "veto_reason"],
      "forbidden_actions": ["originate_signal", "paper_submit", "live_submit", "self_promote", "rewrite_truth"],
      "allowed_actions": ["veto_trade", "set_risk_limit", "write_state", "emit_health"]
    },
    {
      "role_id": "promotion_governance",
      "display_name": "Promotion Governance",
      "tier": "control_plane_promotion",
      "purpose": "Evaluate candidate evidence and record promotion state while preserving explicit human live approval.",
      "allowed_inputs": ["candidate_evidence", "paper_truth", "risk_clearance", "operator_approval"],
      "owned_outputs": ["production_candidate_state", "promotion_decision_receipt"],
      "write_authority": ["production_candidate_state"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["candidate_change", "promotion_review", "operator_approval"],
      "freshness_slo": {"class": "operational", "max_age_seconds": 3600},
      "failure_behavior": {"class": "fail_closed", "default_action": "hold_candidate_and_deny_promotion"},
      "resource_budget": {"profile": "control_plane", "max_parallelism": 1, "memory_mb_soft": 512},
      "escalation_owner": "operator",
      "evidence_outputs": ["candidate_event_chain", "promotion_gate_receipt", "scope_fingerprints"],
      "forbidden_actions": ["paper_submit", "live_submit", "self_approve_live", "rewrite_truth"],
      "allowed_actions": ["promote_candidate", "write_candidate_state", "publish_evidence", "emit_health"]
    },
    {
      "role_id": "paper_execution_gateway",
      "display_name": "Paper Execution Gateway",
      "tier": "execution_plane_paper",
      "purpose": "Consume approved paper intentions and produce simulated broker-faithful executions.",
      "allowed_inputs": ["risk_approved_paper_intents", "paper_broker_state", "execution_policy"],
      "owned_outputs": ["paper_execution_attempts", "paper_fill_events"],
      "write_authority": ["paper_order_submission"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": true, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["approved_paper_intent"],
      "freshness_slo": {"class": "realtime", "max_age_seconds": 30},
      "failure_behavior": {"class": "fail_closed", "default_action": "reject_or_defer_paper_intent_and_record_reason"},
      "resource_budget": {"profile": "latency_sensitive", "max_parallelism": 1, "memory_mb_soft": 768},
      "escalation_owner": "risk_governance",
      "evidence_outputs": ["paper_order_receipt", "simulated_fill_receipt", "execution_realism_metrics"],
      "forbidden_actions": ["originate_signal", "live_submit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["paper_submit", "record_execution_attempt", "emit_health"]
    },
    {
      "role_id": "live_execution_gateway",
      "display_name": "Live Execution Gateway",
      "tier": "execution_plane_live",
      "purpose": "Act as the sole live order writer after every candidate, risk, account, and allowlist gate clears.",
      "allowed_inputs": ["risk_approved_live_intents", "candidate_bound_allowlist", "pinned_account", "broker_state"],
      "owned_outputs": ["live_order_attempts", "broker_submission_receipts"],
      "write_authority": ["live_order_submission"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": true, "automatic_promotion": false},
      "triggers": ["explicitly_approved_live_intent"],
      "freshness_slo": {"class": "realtime", "max_age_seconds": 15},
      "failure_behavior": {"class": "fail_closed", "default_action": "reject_submission_except_verified_risk_reducing_exit"},
      "resource_budget": {"profile": "latency_sensitive", "max_parallelism": 1, "memory_mb_soft": 768},
      "escalation_owner": "risk_governance",
      "evidence_outputs": ["firewall_decision_receipt", "broker_submission_receipt", "candidate_binding_receipt"],
      "forbidden_actions": ["originate_signal", "grant_live_authority", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["live_submit", "record_execution_attempt", "emit_health"]
    },
    {
      "role_id": "truth_reconciliation",
      "display_name": "Truth and Reconciliation",
      "tier": "truth_plane",
      "purpose": "Record append-only execution facts and reconcile broker, account, position, and fill state.",
      "allowed_inputs": ["execution_attempts", "broker_receipts", "account_positions", "fill_events"],
      "owned_outputs": ["execution_truth", "reconciliation_state", "position_truth"],
      "write_authority": ["execution_truth"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["execution_event", "broker_reconcile_cycle", "account_snapshot"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 300},
      "failure_behavior": {"class": "fail_closed", "default_action": "mark_truth_unreconciled_and_block_promotion_or_new_live_risk"},
      "resource_budget": {"profile": "control_plane", "max_parallelism": 1, "memory_mb_soft": 1024},
      "escalation_owner": "risk_governance",
      "evidence_outputs": ["reconciliation_receipt", "immutable_fill_identity", "position_diff"],
      "forbidden_actions": ["originate_signal", "paper_submit", "live_submit", "rewrite_truth", "promote_candidate"],
      "allowed_actions": ["record_truth", "reconcile_broker", "emit_health"]
    },
    {
      "role_id": "infrastructure_maintainer",
      "display_name": "Infrastructure Maintainer",
      "tier": "operations_plane_repair",
      "purpose": "Maintain runtime, storage, freshness, and process health through bounded, auditable repairs.",
      "allowed_inputs": ["health_artifacts", "repair_requests", "resource_pressure", "operator_policy"],
      "owned_outputs": ["repair_events", "infrastructure_state", "process_lifecycle"],
      "write_authority": ["declared_infrastructure_state_domains_only"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["health_violation", "scheduled_maintenance", "operator_command"],
      "freshness_slo": {"class": "operational", "max_age_seconds": 900},
      "failure_behavior": {"class": "bounded_repair", "default_action": "retry_with_cooldown_then_open_circuit_and_escalate"},
      "resource_budget": {"profile": "control_plane", "max_parallelism": 2, "memory_mb_soft": 1024},
      "escalation_owner": "operator",
      "evidence_outputs": ["repair_receipt", "before_after_health", "action_lease_receipt"],
      "forbidden_actions": ["change_trade_logic", "originate_signal", "paper_submit", "live_submit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["restart_process", "repair_infrastructure", "manage_storage", "manage_artifact_lifecycle", "write_state", "emit_health"]
    },
    {
      "role_id": "observability_reporter",
      "display_name": "Observability Reporter",
      "tier": "operations_plane_reporting",
      "purpose": "Render canonical facts and grades without mutating the facts being reported.",
      "allowed_inputs": ["canonical_health_artifacts", "execution_truth", "candidate_state", "role_contract_state"],
      "owned_outputs": ["canonical_health_reporting", "operator_dashboard", "system_self_model"],
      "write_authority": ["reporting_views_only"],
      "execution_authority": {"observe": true, "recommend": false, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["health_refresh", "operator_request", "scheduled_report"],
      "freshness_slo": {"class": "near_realtime", "max_age_seconds": 600},
      "failure_behavior": {"class": "fail_closed", "default_action": "mark_view_stale_and_preserve_source_status"},
      "resource_budget": {"profile": "io_light", "max_parallelism": 2, "memory_mb_soft": 1024},
      "escalation_owner": "infrastructure_maintainer",
      "evidence_outputs": ["source_receipt_set", "grade_explanation", "artifact_age_matrix"],
      "forbidden_actions": ["invent_truth", "repair_source_state", "paper_submit", "live_submit", "promote_candidate", "rewrite_truth"],
      "allowed_actions": ["report_health", "publish_dashboard", "emit_health"]
    },
    {
      "role_id": "training_research",
      "display_name": "Training and Research",
      "tier": "operations_plane_training",
      "purpose": "Train and evaluate candidate models under single-flight, resource, lineage, and holdout controls.",
      "allowed_inputs": ["approved_training_dataset", "labels", "feature_schema", "training_policy"],
      "owned_outputs": ["model_candidates", "training_evidence", "lineage_receipts"],
      "write_authority": ["training_model_artifacts"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["approved_training_window", "targeted_retrain_request"],
      "freshness_slo": {"class": "daily", "max_age_seconds": 259200},
      "failure_behavior": {"class": "abstain", "default_action": "retain_champion_and_quarantine_failed_candidate"},
      "resource_budget": {"profile": "single_flight_heavy", "max_parallelism": 1, "memory_mb_soft": 8192},
      "escalation_owner": "evaluation_auditor",
      "evidence_outputs": ["training_lineage", "holdout_metrics", "resource_usage_receipt"],
      "forbidden_actions": ["self_promote", "paper_submit", "live_submit", "rewrite_truth", "mutate_holdout"],
      "allowed_actions": ["train_model", "publish_model_candidate", "emit_health"]
    },
    {
      "role_id": "evaluation_auditor",
      "display_name": "Evaluation and Audit",
      "tier": "operations_plane_evaluation",
      "purpose": "Validate organization, evidence, capabilities, authority, and model quality without granting execution.",
      "allowed_inputs": ["registry", "candidate_evidence", "control_surfaces", "role_contracts", "model_metrics"],
      "owned_outputs": ["evaluation_evidence", "organization_metadata", "authority_health"],
      "write_authority": ["evaluation_and_metadata_views_only"],
      "execution_authority": {"observe": true, "recommend": true, "paper_trade": false, "risk_veto": false, "live_submit": false, "automatic_promotion": false},
      "triggers": ["candidate_change", "daily_verify", "policy_change", "operator_request"],
